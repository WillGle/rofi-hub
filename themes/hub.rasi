/* Generated by rofi-hub. Overrides welcome; the hub regenerates
   its runtime copy on every launch. */
configuration {
    font: "JetBrainsMono Nerd Font 12";
    show-icons: true;
    disable-history: true;
    hover-select: true;
    cycle: true;
    matching: "fuzzy";
}

* {
    font: "JetBrainsMono Nerd Font 12";
    background-color: #0d1117;
    text-color: #f0f6fc;
    border-color: #161b22;
    selected-normal-background: #161b22;
    selected-normal-foreground: #f0f6fc;
    normal-background: #0d1117;
    normal-foreground: #f0f6fc;
    spacing: 0;
    margin: 0;
    padding: 0;
}

window {
    width: 600px;
    location: center;
    anchor: center;
    border: 0;
    padding: 16px;
    background-color: #0d1117;
}

mainbox {
    background-color: #0d1117;
    children: [ inputbar, listview ];
    spacing: 10px;
    padding: 0;
}

inputbar {
    background-color: #161b22;
    text-color: #f0f6fc;
    padding: 9px 12px;
    border-radius: 6px;
    children: [ prompt, entry ];
    spacing: 8px;
}

prompt {
    background-color: transparent;
    text-color: #8b949e;
}

entry {
    background-color: transparent;
    text-color: #f0f6fc;
    placeholder: "Search apps";
    placeholder-color: #8b949e;
}

listview {
    background-color: #0d1117;
    columns: 1;
    lines: 10;
    spacing: 2px;
    scrollbar: false;
    cycle: true;
    dynamic: true;
    fixed-height: false;
}

element {
    children: [ element-icon, element-text ];
    padding: 9px 12px;
    border-radius: 6px;
    background-color: #0d1117;
    text-color: #f0f6fc;
    spacing: 10px;
}

element selected {
    background-color: #161b22;
    text-color: #f0f6fc;
}

element-icon {
    size: 1.3em;
    background-color: transparent;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}

element normal.active, element alternate.active {
    background-color: #0d1117;
}

element selected.active {
    background-color: #161b22;
    border: 0px 0px 0px 2px;
    border-color: #58a6ff;
}
