#!/bin/sh
case "$*" in
  'radio wifi') echo enabled ;;
  '-t -f DEVICE,TYPE,STATE device')
    printf 'wlan0:wifi:connected\neth0:ethernet:unavailable\n'
    ;;
  *IN-USE,SSID,SIGNAL,SECURITY,FREQ*)
    printf '*:Example WiFi:77:WPA2:5180\n'
    printf ' :Example WiFi:64:WPA2:5745\n'
    printf ' :Neighbor 5G:92:WPA1 WPA2:5180\n'
    printf ' :Neighbor 5G:87:WPA1 WPA2:2412\n'
    printf ' :Guest Network:41:WPA1:2412\n'
    printf ' :IoT 2.4G:69:WPA2:2412\n'
    printf ' :Cafe Open:45:--:2462\n'
    printf ' :Office WiFi:55:WPA2:5745\n'
    printf ' :Library:38:WPA2:2412\n'
    printf ' :Studio 5G:73:WPA2:5180\n'
    printf ' :Workshop:28:WPA2:2462\n'
    printf ' :Cafe Guest:52:--:2412\n'
    printf ' :Neighbor 2.4:66:WPA2:2437\n'
    printf ' :Test Lab:34:WPA2:5500\n'
    printf ' :Visitor:21:--:2412\n'
    ;;
  *GENERAL.HWADDR*device*show*)
    printf 'GENERAL.CONNECTION:Example WiFi\n'
    printf 'GENERAL.HWADDR:02:00:00:00:00:01\n'
    printf 'IP4.ADDRESS[1]:192.0.2.42/24\n'
    printf 'IP4.GATEWAY:192.0.2.1\n'
    printf 'IP4.DNS[1]:192.0.2.53\n'
    printf 'IP4.DNS[2]:192.0.2.54\n'
    ;;
  *NAME,TYPE*connection*show*)
    printf 'Example WiFi:802-11-wireless\n'
    printf 'Office WiFi:802-11-wireless\n'
    printf 'Wired:802-3-ethernet\n'
    ;;
esac
exit 0
