#!/bin/sh
case "$*" in
  'radio wifi') echo enabled ;;
  '-t -f DEVICE,TYPE,STATE device')
    printf 'wlan0:wifi:connected\n'
    ;;
  *IN-USE,SSID,SIGNAL,SECURITY,FREQ*)
    printf '*:Example WiFi:77:WPA2:5180\n'
    printf ' :Neighbor 5G:64:WPA2:5745\n'
    printf ' :Guest Network:41:WPA1:2412\n'
    ;;
  *GENERAL.CONNECTION*device*show*)
    printf 'GENERAL.CONNECTION:Example WiFi\n'
    printf 'GENERAL.HWADDR:02:00:00:00:00:01\n'
    printf 'IP4.ADDRESS[1]:192.0.2.42/24\n'
    printf 'IP4.GATEWAY:192.0.2.1\n'
    printf 'IP4.DNS[1]:192.0.2.53\n'
    ;;
  *NAME,TYPE*connection*show*)
    printf 'Example WiFi:802-11-wireless\n'
    printf 'Office WiFi:802-11-wireless\n'
    ;;
esac
exit 0
