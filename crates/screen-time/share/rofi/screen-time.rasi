/* Generated by rofi-hub. Overrides welcome; the hub regenerates
   its runtime copy on every launch. */
configuration {
    font: "JetBrainsMono Nerd Font 12";
    show-icons: false;
    disable-history: true;
    hover-select: false;
    cycle: true;
    matching: "fuzzy";
}

* {
    font: "JetBrainsMono Nerd Font 12";
    background-color: #1d2021;
    text-color: #fbf1c7;
    border-color: #282828;
    selected-normal-background: #282828;
    selected-normal-foreground: #fbf1c7;
    normal-background: #1d2021;
    normal-foreground: #fbf1c7;
    foreground: #fbf1c7;
    background: #1d2021;
    spacing: 0;
    margin: 0;
    padding: 0;
}

/* Match the Screen Time window: flat chrome, generous padding, and the same
   centered geometry. */
window {
    width: calc( ( 144ch + 64px ) min 94% );
    location: center;
    anchor: center;
    border: 0;
    padding: 20px;
    background-color: #1d2021;
}

mainbox {
    background-color: #1d2021;
    children: [ inputbar, message, listview ];
    spacing: 8px;
    padding: 0;
}

/* Screen Time draws its header with message/textbox. The dmenu apps keep an
   input bar for filtering, but style it as the same flat header surface. */
inputbar {
    background-color: #1d2021;
    text-color: #fbf1c7;
    padding: 0px 5px;
    border: 0;
    children: [ prompt, entry ];
    spacing: 8px;
}

/* Screen Time styles its header through message/textbox. Keep the same flat
   surface for dmenu messages such as the calendar sheet. */
message, textbox {
    background-color: #1d2021;
    text-color: #fbf1c7;
    padding: 0px 5px;
    border: 0;
}

prompt {
    background-color: transparent;
    text-color: #a89984;
}

entry {
    background-color: transparent;
    text-color: #fbf1c7;
    placeholder: "Type to filter";
    placeholder-color: #a89984;
}

listview {
    background-color: #1d2021;
    columns: 1;
    lines: 24;
    spacing: 0;
    scrollbar: false;
    cycle: true;
    dynamic: true;
    fixed-height: false;
}

/* Screen Time uses a flat row plus a 2px accent strip for the active row. */
element normal.active, element alternate.active, element selected.active {
    background-color: #282828;
    border: 0;
    border-radius: 0;
}

element selected.active {
    border: 0px 0px 0px 2px;
    border-color: #fabd2f;
}

element {
    children: [ element-icon, element-text ];
    padding: 3px 10px;
    background-color: #1d2021;
    text-color: #fbf1c7;
    spacing: 8px;
}

element selected {
    background-color: #282828;
    text-color: #fbf1c7;
}

element-icon {
    size: 1.2em;
    background-color: transparent;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    font: "JetBrainsMono Nerd Font 12";
    vertical-align: 0.5;
}
