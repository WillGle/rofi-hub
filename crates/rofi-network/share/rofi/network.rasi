/* Generated by rofi-dmenu: app layout + palette fallback.
   Overrides welcome; the app regenerates its runtime copy when it changes. */
configuration {
    font: "JetBrainsMono Nerd Font 12";
    show-icons: true;
    disable-history: true;
    hover-select: false;
    cycle: true;
    matching: "fuzzy";
}

* {
    font: "JetBrainsMono Nerd Font 12";
    background-color: #1d2021;
    text-color: #fbf1c7;
    border-color: #3c3836;
    selected-normal-background: #282828;
    selected-normal-foreground: #fbf1c7;
    normal-background: #1d2021;
    normal-foreground: #fbf1c7;
    foreground: #fbf1c7;
    background: #1d2021;
    spacing: 0;
    margin: 0;
    padding: 0;
}

/* Zoned chrome: one bordered card for filter, header, and list. */
window {
    width: calc( ( 90ch + 64px ) min 94% );
    location: center;
    anchor: center;
    border: 1px;
    border-color: #3c3836;
    border-radius: 12px;
    padding: 12px;
    background-color: #1d2021;
}

mainbox {
    background-color: #1d2021;
    children: [ inputbar, message, listview ];
    spacing: 8px;
    padding: 0;
}

inputbar {
    background-color: #282828;
    text-color: #fbf1c7;
    padding: 6px 12px;
    border: 1px;
    border-color: #3c3836;
    border-radius: 8px;
    children: [ prompt, entry ];
    spacing: 10px;
}

message {
    background-color: #282828;
    text-color: #fbf1c7;
    padding: 0px 12px;
    border: 0px 0px 1px 0px;
    border-color: #3c3836;
}

textbox {
    background-color: transparent;
    text-color: #fbf1c7;
    padding: 0;
    border: 0;
}

prompt {
    background-color: transparent;
    text-color: #fabd2f;
}

entry {
    background-color: transparent;
    text-color: #fbf1c7;
    placeholder: "Type to filter";
    placeholder-color: #a89984;
}

listview {
    background-color: #282828;
    columns: 1;
    lines: 10;
    spacing: 0;
    scrollbar: false;
    cycle: true;
    dynamic: true;
    fixed-height: false;
    padding: 4px;
    border: 1px;
    border-color: #3c3836;
    border-radius: 8px;
}

/* Section rows are marked active by the apps; the band separates zones. */
element normal.active, element alternate.active, element selected.active {
    background-color: #32302f;
    border: 0px 0px 1px 0px;
    border-color: #3c3836;
    border-radius: 4px;
}

element {
    children: [ element-icon, element-text ];
    padding: 4px 10px;
    background-color: #282828;
    text-color: #fbf1c7;
    spacing: 8px;
    border: 0px 0px 1px 0px;
    border-color: #3c3836;
    border-radius: 0;
}

element selected {
    background-color: #32302f;
    text-color: #fbf1c7;
    border: 0px 0px 1px 2px;
    border-color: #fabd2f;
    border-radius: 4px;
}

element selected.active {
    background-color: #32302f;
    border: 0px 0px 1px 2px;
    border-color: #fabd2f;
    border-radius: 4px;
}

element-icon {
    size: 1.2em;
    background-color: transparent;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    font: "JetBrainsMono Nerd Font 12";
    vertical-align: 0.5;
}
