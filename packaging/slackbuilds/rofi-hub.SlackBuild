#!/bin/bash
#
# SlackBuild script for rofi-hub.
# Requires rust and cargo (available from SlackBuilds.org or rustup).
#
# Copyright 2026 WillGle <willgle@users.noreply.github.com>
# All rights reserved.
#
# Redistribution and use of this script, with or without modification, is
# permitted provided that the following conditions are met:
#
# 1. Redistributions of this script must retain the above copyright
#    notice, this list of conditions and the following disclaimer.
#
# THIS SOFTWARE IS PROVIDED BY THE AUTHOR "AS IS" AND ANY EXPRESS OR IMPLIED
# WARRANTIES ARE DISCLAIMED.

cd "$(dirname "$0")" || exit 1
CWD=$(pwd)
TMP=${TMP:-/tmp/SBo}
PKG=$TMP/package-$PRGNAM
OUTPUT=${OUTPUT:-/tmp}

set -e

PRGNAM=rofi-hub
VERSION=${VERSION:-0.2.0}
BUILD=${BUILD:-1}
TAG=${TAG:-_SBo}
PKGTYPE=${PKGTYPE:-tgz}

if [ -z "$ARCH" ]; then
  case "$(uname -m)" in
    x86_64) ARCH=x86_64 ;;
    aarch64) ARCH=aarch64 ;;
    *) echo "$ARCH is not supported" ; exit 1 ;;
  esac
fi

SRCNAM=$PRGNAM
SRCDIR=$TMP/$SRCNAM-$VERSION
PKG=$TMP/package-$PRGNAM

rm -rf "$PKG" "$TMP/$SRCNAM-$VERSION"
mkdir -p "$TMP" "$PKG" "$OUTPUT"
cd "$TMP"
tar xf "$CWD/$PRGNAM-$VERSION-source.tar.gz"

cd "$SRCDIR"
chown -R root:root .
find -L . -type f -exec chmod 644 {} \;
# install-tree.sh is invoked directly by package(); restore its mode after
# the source-tree normalization above.
chmod 755 packaging/install-tree.sh

export CARGO_TARGET_DIR="$SRCDIR/target"
cargo build --release --locked --workspace
cargo test --workspace --locked

DESTDIR="$PKG" PREFIX=/usr packaging/install-tree.sh --all

# install-tree.sh already applies 644/755 per file; do not flatten the
# executable bits before makepkg.
find "$PKG" -type d -exec chmod 755 {} \;

cd "$PKG"
/sbin/makepkg -l y -c n "$OUTPUT/$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE"
