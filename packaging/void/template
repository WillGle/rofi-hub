# Template file for 'rofi-hub'
# Build with: xbps-src pkg rofi-hub
pkgname=rofi-hub
version=0.2.0
revision=1
build_style=cargo
hostmakedepends="cargo rust gcc make pkg-config"
# Void's cargo build style links the system SQLite here; keep the headers and
# runtime library explicit so the build does not depend on a transitive sqlite.
makedepends="sqlite-devel"
depends="rofi bash sqlite"
short_desc="Rofi launcher with screen-time, calendar, keybinds, and clipboard apps"
maintainer="WillGle <willgle@users.noreply.github.com>"
license="MIT"
homepage="https://github.com/WillGle/rofi-hub"
distfiles="https://github.com/WillGle/rofi-hub/releases/download/v${version}/rofi-hub-${version}-source.tar.gz"
checksum=dea9c784616d93b00e206f7a676a64b828f29a6bc30f27df395d0c695af5f617
wrksrc="rofi-hub-${version}"

do_check() {
	cd "${wrksrc}"
	cargo test --workspace --locked
}

do_install() {
	cd "${wrksrc}"
	target="${wrksrc}/target/${RUST_TARGET}/release"
	[ -x "${target}/rofi-hub" ] || target="${wrksrc}/target/release"
	DESTDIR="${DESTDIR}" PREFIX=/usr TARGETDIR="${target}" \
		./packaging/install-tree.sh --all
}
