# Alpine APKBUILD. Tested with `abuild -r` in alpine:edge.
pkgname=rofi-hub
pkgver=0.2.0
pkgrel=0
pkgdesc="Rofi launcher with screen-time, calendar, keybinds, and clipboard apps"
url="https://github.com/WillGle/rofi-hub"
maintainer="WillGle <willgle@users.noreply.github.com>"
arch="x86_64 aarch64"
license="MIT"
depends="rofi bash"
makedepends="cargo rust"
checkdepends="tzdata"
source="$pkgname-$pkgver.tar.gz::https://github.com/WillGle/rofi-hub/releases/download/v$pkgver/rofi-hub-$pkgver-source.tar.gz"
sha512sums="a92d5984bb5ca3bbc028dd6582c6a34ca437aefb662b0caba6eb221821822d9adb7e863c2ac761f81b747447ae262c2f3fd28b20c8f0ae0079294572d4151e4e  rofi-hub-$pkgver.tar.gz"
builddir="$srcdir/rofi-hub-$pkgver"

build() {
	cd "$builddir"
	cargo build --release --locked --workspace
}

check() {
	cd "$builddir"
	cargo test --workspace --locked
}

package() {
	cd "$builddir"
	DESTDIR="$pkgdir" PREFIX=/usr packaging/install-tree.sh --all
}
