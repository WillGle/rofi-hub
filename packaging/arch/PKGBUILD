# Maintainer: WillGle <willgle@users.noreply.github.com>
# Source package for AUR/Arch. The release asset is generated from the tagged
# tree by scripts/package-source.sh and contains packaging/.
pkgname=rofi-hub
pkgver=0.2.0
pkgrel=1
pkgdesc="Rofi launcher with screen-time, calendar, keybinds, and clipboard apps"
arch=('x86_64' 'aarch64')
url="https://github.com/WillGle/rofi-hub"
license=('MIT')
depends=('rofi' 'bash' 'hicolor-icon-theme')
makedepends=('cargo' 'rust')
optdepends=(
  'cliphist: clipboard history'
  'wl-clipboard: clipboard copy'
  'hyprland: keybinds and screen-time'
  'systemd: Screen Time user service'
)
provides=('rofi-hub')
conflicts=('rofi-hub-bin' 'rofi-hub-git')
# makepkg's C LTO flag produces GCC LTO objects for bundled SQLite, which
# rustc's lld link step cannot consume. Rust still uses its thin LTO profile.
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::https://github.com/WillGle/rofi-hub/releases/download/v$pkgver/rofi-hub-$pkgver-source.tar.gz")
sha256sums=('e9d291ac5dc1aed545d8c769aad07d9e3bd1d9a56686617d5cfc23b40d84a527')

build() {
  cd "$pkgname-$pkgver"
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --release --locked --workspace
}

check() {
  cd "$pkgname-$pkgver"
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo test --workspace --locked
}

package() {
  cd "$pkgname-$pkgver"
  export CARGO_TARGET_DIR="$srcdir/target"
  DESTDIR="$pkgdir" PREFIX=/usr packaging/install-tree.sh --all
}
