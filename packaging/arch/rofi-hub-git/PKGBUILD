# Maintainer: WillGle <willgle@users.noreply.github.com>
# Live git build. The repository copy of packaging/install-tree.sh is used so
# the installed tree always matches the checked-out commit.
pkgname=rofi-hub-git
pkgver=0.2.0.r0.gfc0e5aa
pkgrel=1
pkgdesc="Rofi launcher with screen-time, calendar, keybinds, and clipboard apps (git)"
arch=('x86_64' 'aarch64')
url="https://github.com/WillGle/rofi-hub"
license=('MIT')
depends=('rofi' 'bash' 'hicolor-icon-theme')
makedepends=('cargo' 'rust' 'git')
optdepends=(
  'cliphist: clipboard history'
  'wl-clipboard: clipboard copy'
  'hyprland: keybinds and screen-time'
  'systemd: Screen Time user service'
)
provides=('rofi-hub')
conflicts=('rofi-hub' 'rofi-hub-bin')
# See the source PKGBUILD: bundled SQLite must not be built with GCC LTO.
options=('!lto')
source=("rofi-hub::git+https://github.com/WillGle/rofi-hub.git")
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/rofi-hub"
  git describe --long --tags --abbrev=7 | sed 's/^v//; s/\([^-]*-g\)/r\1/; s/-/./g'
}

build() {
  cd "$srcdir/rofi-hub"
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --release --locked --workspace
}

check() {
  cd "$srcdir/rofi-hub"
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo test --workspace --locked
}

package() {
  cd "$srcdir/rofi-hub"
  export CARGO_TARGET_DIR="$srcdir/target"
  DESTDIR="$pkgdir" PREFIX=/usr packaging/install-tree.sh --all
}
