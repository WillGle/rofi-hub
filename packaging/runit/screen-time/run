#!/bin/sh
# runit service for Screen Time: packaging/runit/screen-time/run
#
# Install as /etc/sv/screen-time/run (or under a user supervision tree),
# then link into /var/service. Run as the desktop user, not root.
exec 2>&1
export HOME="${SCREEN_TIME_HOME:-${HOME:-/home/$USER}}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
exec chpst -u "${SCREEN_TIME_USER:-$USER}" /usr/bin/screen-time daemon
